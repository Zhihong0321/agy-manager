# agy-web configuration. Copy to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit it. On Railway, set these as service variables instead.

# Bearer token guarding every /api/* route. REQUIRED, >= 16 chars,
# or the server refuses to start.
AGY_WEB_TOKEN=change-me-to-a-random-secret-of-16-plus-chars

# --- optional overrides (defaults shown) ---
# Listen port (Railway injects PORT).
#PORT=8080
# agy-cli-manager state + account profiles. On the volume in the container.
#AGY_MANAGER_ROOT=~/.agy-cli-manager
# Live agy home the active profile syncs into.
#AGY_MANAGER_LIVE_DIR=~/.gemini
# Path to the agy binary (defaults to `which agy`).
#AGY_BINARY=
# Per-prompt timeout, seconds.
#AGY_PROMPT_TIMEOUT=180
# Interactive login timeout, seconds.
#AGY_LOGIN_TIMEOUT=600
# Set SSH_* so agy prints an OAuth URL instead of launching a browser.
#AGY_FAKE_SSH=true
